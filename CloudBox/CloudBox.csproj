<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Configurations>Debug;Release</Configurations>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="ApiCommands.cs" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="System.Text.Json" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Dual-reference pattern: the local sibling project wins in solution builds; the
	       published NuGet package is restored when the sibling is absent (public CI builds
	       cannot check out the EncryptedMessaging repo). -->
	  <ProjectReference Include="..\..\..\..\EncryptedMessaging\EncryptedMessaging\EncryptedMessaging.csproj" Condition="Exists('..\..\..\..\EncryptedMessaging\EncryptedMessaging\EncryptedMessaging.csproj')" />
	  <PackageReference Include="EncryptedMessaging" Version="1.*" Condition="!Exists('..\..\..\..\EncryptedMessaging\EncryptedMessaging\EncryptedMessaging.csproj')" />
	  <ProjectReference Include="..\CloudSync\CloudSync.csproj" />
	</ItemGroup>

</Project>
